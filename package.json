{
  "name": "last-line",
  "description": "Last Line - a top-down tactical defense game inspired by Mud and Blood 2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "node scripts/typecheck.mjs --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "perf": "node scripts/benchmark.mjs",
    "perf:quick": "node scripts/benchmark.mjs --repeats 1 --duration-ms 2000 --warmup-ms 1000",
    "perf:stress": "node scripts/stress.mjs",
    "perf:test": "node --test scripts/benchmark.test.mjs",
    "perf:profile": "node scripts/profile.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tsrs/wasm": "0.18.0-ts7.1.0-dev.20260929",
    "@types/three": "0.183.1",
    "happy-dom": "^20.14.5",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  }
}
